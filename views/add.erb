<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/css/w3.css">
  <link rel="stylesheet" href="/css/styles.css">
  <script type="text/javascript" src="/js/aes.js"></script>
  <script type="text/javascript" src="/js/encryption.js"></script>
  <script src="/js/jquery-3.6.0.min.js"></script>
  <link href="/css/bootstrap.css" rel="stylesheet">
  <script src="/js/bootstrap.min.js"></script>
  <link href="/css/summernote.css" rel="stylesheet">
  <script src="/js/summernote.js"></script>
  <script src="/js/html_edit.js" type="text/javascript"></script>
  <%= jump_nav_js %>
</head>
<% if @follow %>
  <body onload="jump_nav(<%= @follow %>);">
<% else %>
  <body>
<% end %>

<div id="popup_enc">
  <div>Enter Passphrase to encrypt:</div>
  <input id="pass" type="password"/>
  <button onclick="popup_enc_post('id_form_body','id_textarea_body')">Encrypt</button>
  <button onclick="popup_enc_cancel()">Cancel</button>
</div>

<header>New article</header>
<menu_bar>
  <a href="/" class="menu_button"><button>Home</button></a>
  <form action="/" method="GET" class="search_box">
    <input type="text" name="search_text" class="search" id="search_text" placeholder="Search here!">
  </form>
</menu_bar>

<%= @navigator %>

<article>
  <% if @error %>
    <p style="color:red;"><%= h(@error) %></p>
  <% end %>

  <label>Date</label> <%= Time.now.strftime('%Y-%m-%d %H:%M') %>

  <div style="display:block; height:100%;">
    <form method="post" style="height:100%;" id="id_form_body"
          enctype="multipart/form-data" onsubmit="search_encrypt_tag();">
      <input type="hidden" name="csrf_token" value="<%= h(@csrf_token) %>">

      <% if @follow_row %>
        <label>Follow-up Article</label>
        <a href="/?a_id=<%= @follow %>"><%= format('%04d', @follow) %></a><br>

        <label>Title</label>
        <textarea name="title1" rows="1" style="height:10%"><%= h(@follow_row['a_title'].to_s) %></textarea>

        <label>Article</label>
        <div class="sliderdiv">
          <label class="switch">
            <input id="id_html_switch" type="checkbox"
                   onchange="toggle_html('id_html_switch','id_textarea_body');">
            <span class="slider"></span>
          </label>
          &nbsp; HTML Editor
        </div>
        <textarea id="id_textarea_body" name="article1" style="height:80%"><%= h(@follow_keywords) %>
</textarea>
        <input type="hidden" name="link1" value="<%= @follow %>">
      <% else %>
        <label>Title</label>
        <textarea name="title1" rows="1" style="height:10%"></textarea>
        <label>Article Text</label>
        <textarea id="id_textarea_body" name="article1"></textarea>
      <% end %>

      <input type="button" class="button" value="Add" onclick="search_encrypt_tag()">
      <input type="submit" name="cancel" class="button" value="Cancel">
    </form>
  </div>
</article>
</section>

</body>
</html>
