<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Login</title>
  <style>
    body { font: 14px sans-serif; }
    .wrapper { width: 360px; padding: 20px; }
  </style>
</head>
<body>
  <div class="wrapper">
    <h2>Login</h2>
    <p>Please fill in your credentials to login.</p>

    <% unless @login_err.empty? %>
      <div style="color:red;"><%= h(@login_err) %></div>
    <% end %>

    <form action="/auth/login" method="post">
      <input type="hidden" name="csrf_token" value="<%= h(@csrf_token) %>">
      <div class="form-group">
        <label>Username</label>
        <input type="text" name="username" value="<%= h(@username) %>">
        <% unless @username_err.empty? %><span style="color:red;"><%= h(@username_err) %></span><% end %>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password">
        <% unless @password_err.empty? %><span style="color:red;"><%= h(@password_err) %></span><% end %>
      </div>
      <div class="form-group">
        <input type="submit" value="Login">
      </div>
    </form>
  </div>
</body>
</html>
